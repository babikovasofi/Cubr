# Copy this file to .env and fill in real values.
# .env is git-ignored (see .gitignore) — secrets never get committed.

# transcribe: HuggingFace token for speaker diarization (pyannote).
# Create one at https://huggingface.co/settings/tokens (read scope is enough),
# then accept the model terms for pyannote/speaker-diarization.
HF_TOKEN=

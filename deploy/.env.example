# Copy to deploy/.env on the server, chmod 600, owner deploy. Never commit the
# real file — .gitignore already excludes .env / .env.* everywhere except
# *.env.example.
#
# This is backend/.env.example's list with production values filled in where
# they must differ from local dev. See backend/.env.example for what every
# setting does; tests/test_env_example.py there is the source of truth for
# which settings app/config.py reads.
#
# Two extra keys live only here, for docker-compose / Caddy, not for the app:
# POSTGRES_PASSWORD and SITE_DOMAIN.

# --- Postgres (used by the `db` service; DATABASE_URL below must embed the
#     same password) ---
POSTGRES_PASSWORD=

# --- Caddy ---
# The domain Caddy requests a Let's Encrypt cert for. Either cubr-game.ru once
# its A record resolves to this host, or the sslip.io fallback
# (135-106-181-244.sslip.io) — see docs/deploy.md.
SITE_DOMAIN=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cubr:<POSTGRES_PASSWORD>@db:5432/cubr

CORS_ORIGINS=https://cubr-game.ru

APP_ENV=production

# --- Secrets (REQUIRED — boot fails if unset, or if a value contains
#     "change-me"/"placeholder"/"example"). Generate each ON THE SERVER, each
#     with its own command, never copied from a sibling:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=
RESET_VERIFY_SECRET=
SCRAMBLE_SIGN_SECRET=
DUEL_SIGN_SECRET=

# --- Auth cookie ---
JWT_LIFETIME_SECONDS=3600
COOKIE_NAME=cubr_auth
COOKIE_SAMESITE=lax

# --- Frontend / redirects ---
FRONTEND_URL=https://cubr-game.ru

# --- Email (Resend primary; Brevo alt via EMAIL_PROVIDER=brevo) ---
# Deliberately deferred to the morning: SPF/DKIM need to be published on the
# EMAIL_FROM domain first (see docs/deploy.md). Leave blank; the app runs
# fine without it, only outgoing mail is disabled.
EMAIL_FROM=Cubr <no-reply@cubr-game.ru>
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=

# --- Google OAuth ---
# Deliberately deferred: needs this exact redirect URL pre-registered in the
# Google console. Leave blank; password login is unaffected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://cubr-game.ru/api/auth/google/callback

# --- Rate limiting ---
AUTH_RATE_LIMIT=10/minute
EMAIL_RATE_LIMIT=3/hour
SCRAMBLE_RATE_LIMIT=60/minute
TOURNAMENT_RATE_LIMIT=60/minute
DAILY_RATE_LIMIT=60/minute
SOLVE_RATE_LIMIT=30/minute
# The static IP of the caddy container on the `cubr` docker network (see
# deploy/docker-compose.yml ipv4_address). Not 127.0.0.1 — api and caddy are
# separate containers here.
TRUSTED_PROXIES=172.28.0.10

# --- Scramble tokens ---
SCRAMBLE_TOKEN_TTL=3600

# --- Weekly tournament ---
TOURNAMENT_ATTEMPT_WINDOW_SECONDS=600
TOURNAMENT_STANDINGS_LIMIT_DEFAULT=50
TOURNAMENT_STANDINGS_LIMIT_MAX=200

# --- Daily scramble ---
DAILY_ATTEMPT_WINDOW_SECONDS=600
DAILY_BOARD_LIMIT_DEFAULT=50
DAILY_BOARD_LIMIT_MAX=200

# --- Link-invite duels ---
DUEL_RATE_LIMIT=30/minute
DUEL_ALLOWED_WS_ORIGINS=https://cubr-game.ru
DUEL_INVITE_TTL_SECONDS=86400
# Незавершённая комната старше этого считается мёртвой и отпускает участников:
# состояние идущей дуэли живёт в памяти процесса, и рестарт API его теряет.
DUEL_ROOM_STALE_SECONDS=7200
DUEL_SESSION_TOKEN_TTL_SECONDS=7200
DUEL_PREP_TIMEOUT_SECONDS=180
DUEL_SOLVE_TIMEOUT_SECONDS=600
DUEL_DISCONNECT_GRACE_SECONDS=60
DUEL_HEARTBEAT_INTERVAL_SECONDS=5
DUEL_HEARTBEAT_TIMEOUT_SECONDS=15
DUEL_COUNTDOWN_SECONDS=3
DUEL_SERIES_GAP_SECONDS=3600

# Duel rooms live in one process's memory. app/main.py refuses to boot above
# 1, and deploy/docker-compose.yml only ever runs one `api` container.
WEB_CONCURRENCY=1

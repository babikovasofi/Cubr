# SPA + API on one origin. Cookie auth is SameSite=Lax and duel WebSocket
# handshakes check Origin (DUEL_ALLOWED_WS_ORIGINS) — a second origin for the
# API would break both, so Caddy is the single front door.

# The bare domain is canonical; www redirects to it rather than serving a
# second copy. Two equal origins would mean the auth cookie (SameSite=Lax) and
# the duel WebSocket Origin check work on whichever host the user happened to
# type, and fail silently on the other.
# Response security headers live in one place for both front doors (Caddy here,
# `vite preview` on the local ZAP stand) — deploy/security-headers.json, rendered
# into the imported file by deploy/scripts/gen-security-headers.mjs.
import security-headers.caddy

www.{$SITE_DOMAIN} {
    import security_headers
    import hsts
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    import security_headers
    import hsts

    encode zstd gzip

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}

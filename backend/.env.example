# Copy to .env for local dev; in production these are set in the platform's
# environment, never in a file (see docs/deploy.md).
#
# Every setting app/config.py reads appears here — tests/test_env_example.py
# fails if a new one is added without a line in this file, so a deploy can never
# be configured from an out-of-date list.
#
# The values below are LOCAL defaults. Lines marked `# prod:` say what has to
# change on a real deploy.

DATABASE_URL=postgresql+asyncpg://cubr:cubr@localhost:5432/cubr
# prod: the platform's Postgres URL, with the driver forced to asyncpg
#       (postgresql+asyncpg://…, NOT the bare postgresql:// the platform hands out).

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# prod: the real site origin(s), e.g. https://cubr.app,https://www.cubr.app

APP_ENV=local
# prod: anything other than `local` — that alone flips auth cookies to Secure.

# --- Secrets (REQUIRED — boot fails if unset). Generate each with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET signs auth JWTs; RESET_VERIFY_SECRET signs reset/verify tokens; SCRAMBLE_SIGN_SECRET
# signs GET /scramble -> POST /solves tokens; DUEL_SIGN_SECRET signs duel WS
# session/reconnect tokens; UNSUBSCRIBE_SIGN_SECRET signs chat-email unsubscribe
# tokens (all five kept separate).
# Boot refuses any value containing "change-me"/"placeholder"/"example" in EVERY
# environment, so these five placeholders cannot reach production by accident.
SECRET=change-me-in-2.2-auth-stage
RESET_VERIFY_SECRET=change-me-too-separate-reset-verify-secret
SCRAMBLE_SIGN_SECRET=change-me-too-separate-scramble-sign-secret
DUEL_SIGN_SECRET=change-me-too-separate-duel-sign-secret
UNSUBSCRIBE_SIGN_SECRET=change-me-too-separate-unsubscribe-sign-secret

# --- Auth cookie ---
JWT_LIFETIME_SECONDS=2592000
COOKIE_NAME=cubr_auth
COOKIE_SAMESITE=lax
# COOKIE_SAMESITE stays `lax` in prod: the SPA reaches the API through Vercel's
# same-origin /api rewrite, so nothing is cross-site. `none` would only be
# needed if the frontend ever called the API host directly.

# --- Frontend / redirects ---
FRONTEND_URL=http://localhost:5173
# prod: https://<the site's domain> — verification/reset links point here.

# --- Email (Resend primary; Brevo alt via EMAIL_PROVIDER=brevo) ---
EMAIL_FROM=Cubr <no-reply@cubr.app>
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
# prod: a real key, and the EMAIL_FROM domain needs SPF+DKIM published
#       (docs/deploy.md) or the mail lands in spam.

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
# prod: https://<domain>/api/auth/google/callback — the SAME string must be
#       registered in the Google console, character for character.

# --- Rate limiting ---
AUTH_RATE_LIMIT=10/minute
# Per-ACCOUNT login throttle (keyed by the email being attacked), on top of
# AUTH_RATE_LIMIT's per-IP window — without it, an attacker spraying guesses
# at one account from a hundred rotating IPs never trips anything.
LOGIN_ACCOUNT_RATE_LIMIT=10/minute
EMAIL_RATE_LIMIT=3/hour
SCRAMBLE_RATE_LIMIT=60/minute
TOURNAMENT_RATE_LIMIT=60/minute
DAILY_RATE_LIMIT=60/minute
SOLVE_RATE_LIMIT=30/minute
# Comma-separated proxy IPs allowed to set X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1
# prod: the platform's proxy. Too wide an allowlist lets a client forge its own
#       IP and walk around every limit above; too narrow rate-limits the whole
#       site as one client.

# --- Scramble tokens ---
SCRAMBLE_TOKEN_TTL=3600

# --- Weekly tournament (Этап 5) ---
# Window from attempt/start to a still-accepted attempt/submit; a later submit
# is forced to "dnf". Expired attempts are swept by the external finalize cron.
TOURNAMENT_ATTEMPT_WINDOW_SECONDS=600
TOURNAMENT_STANDINGS_LIMIT_DEFAULT=50
TOURNAMENT_STANDINGS_LIMIT_MAX=200

# --- Daily scramble ---
DAILY_ATTEMPT_WINDOW_SECONDS=600
DAILY_BOARD_LIMIT_DEFAULT=50
DAILY_BOARD_LIMIT_MAX=200

# --- Link-invite duels (Этап 4) ---
DUEL_RATE_LIMIT=30/minute
# Separate CORS-like allowlist for the WS handshake's Origin header (CSWSH; a
# WS upgrade isn't covered by CORSMiddleware).
DUEL_ALLOWED_WS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# prod: the real site origin(s), same list as CORS_ORIGINS.
DUEL_INVITE_TTL_SECONDS=86400
# Незавершённая комната старше этого считается мёртвой и отпускает участников:
# состояние идущей дуэли живёт в памяти процесса, и рестарт API его теряет.
DUEL_ROOM_STALE_SECONDS=7200
DUEL_SESSION_TOKEN_TTL_SECONDS=7200
DUEL_PREP_TIMEOUT_SECONDS=180
DUEL_SOLVE_TIMEOUT_SECONDS=600
DUEL_DISCONNECT_GRACE_SECONDS=60
DUEL_HEARTBEAT_INTERVAL_SECONDS=5
DUEL_HEARTBEAT_TIMEOUT_SECONDS=15
DUEL_COUNTDOWN_SECONDS=3
# Pause after which a rematch starts a new series rather than continuing the
# current one (GET /duel/rooms/{id}/series) — "one sitting", tune to taste.
DUEL_SERIES_GAP_SECONDS=3600

# --- Friends (mutual, added by public_handle only) ---
FRIENDS_RATE_LIMIT=60/minute
# Extra per-CALLING-USER throttle on POST /friends/requests (on top of
# FRIENDS_RATE_LIMIT's per-IP window) — an IP-keyed limit alone doesn't
# defend against probing which public_handles exist (rotating IP resets it).
FRIEND_REQUEST_RATE_LIMIT=10/minute

# --- Friend chat (Этап A: переписка, без единого письма) ---
# notify_after = created_at + this — column ships now, acted on only from
# Этап B's sweep job.
CHAT_NOTIFY_DELAY_SECONDS=300
# How stale user_presence.last_seen_at may be before GET /chat/poll bothers
# writing it again.
CHAT_PRESENCE_WRITE_INTERVAL_SECONDS=30
# Long-poll park time; the poll endpoint never holds a pooled DB connection
# across this wait — see app.routers.chat module docstring.
CHAT_POLL_TIMEOUT_SECONDS=25
CHAT_SEND_RATE_LIMIT=20/minute
CHAT_SEND_PER_CONVERSATION_LIMIT=10/minute
CHAT_SEND_DAILY_LIMIT=300/day
CHAT_POLL_RATE_LIMIT=30/minute

# --- Friend chat (Этап B: письма) ---
# N5 hourly throttle: minimum gap between two chat-notification emails for
# the same (conversation, recipient).
CHAT_EMAIL_INTERVAL_SECONDS=3600
# Daily cap on chat-notification emails PER (conversation, recipient); the
# 4th pending message of the day gets `throttled_expired` instead of a 4th email.
CHAT_EMAIL_MAX_PER_CONVERSATION_PER_DAY=3

# --- friends-hub (Этап A: presence dot on /friends) ---
# A friend's user_presence.last_seen_at no older than this counts as
# "online" (green dot) on GET /friends.
CHAT_PRESENCE_ONLINE_WINDOW_SECONDS=60

# --- friends-hub (Этап B: duel invite messages) ---
# How long a "Позвать на дуэль" invite stays clickable — deliberately short
# (game/Discord-style), NOT the 24h open-link TTL: no room exists until
# accepted, so a stale button is the only cost, not a blocked duel slot.
INVITE_TTL_SECONDS=180
CHAT_INVITE_RATE_LIMIT=10/minute

# --- friends-hub (Этап C: random-opponent matchmaking) ---
# Queue rows live in the DB (matchmaking_queue), not process memory — a
# deploy restart must not strand a waiting player forever.
MATCHMAKING_POLL_TIMEOUT_SECONDS=25
MATCHMAKING_RATE_LIMIT=30/minute
MATCHMAKING_POLL_RATE_LIMIT=30/minute

# Duel rooms live in one process's memory — main.py refuses to boot if this is > 1,
# and the platform must hold replicas at 1 as well (backend/railway.json).
WEB_CONCURRENCY=1
